@model CursoFormularioViewModel
@using EscolaDeCursos.WebApp.Modulos.ModuloCurso.Apresentacao.ViewModels
@{
    Layout = "_Layout";
    ViewBag.Titulo = "Editar Curso";
}

<div class="card shadow-sm" style="max-width: 720px;">
    <div class="card-body p-4">
        <form asp-action="Editar" asp-route-id="@Model.Id" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <div class="mb-3">
                <label asp-for="Titulo" class="form-label"></label>
                <input asp-for="Titulo" class="form-control" />
                <span asp-validation-for="Titulo" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Descricao" class="form-label"></label>
                <textarea asp-for="Descricao" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Descricao" class="text-danger small"></span>
            </div>

            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <label asp-for="CargaHoraria" class="form-label"></label>
                    <input asp-for="CargaHoraria" class="form-control" type="number" min="1" />
                    <span asp-validation-for="CargaHoraria" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Nivel" class="form-label"></label>
                    <select asp-for="Nivel" class="form-select" asp-items="Html.GetEnumSelectList<EscolaDeCursos.Dominio.Modulos.ModuloCurso.NivelCurso>()"></select>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="CategoriaId" class="form-label"></label>
                <select asp-for="CategoriaId" class="form-select" asp-items="ViewBag.Categorias"></select>
                <span asp-validation-for="CategoriaId" class="text-danger small"></span>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-success">Salvar</button>
                <a asp-action="Listar" class="btn btn-outline-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>
