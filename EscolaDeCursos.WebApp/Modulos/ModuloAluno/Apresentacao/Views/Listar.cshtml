@model List<AlunoListarViewModel>
@using EscolaDeCursos.WebApp.Modulos.ModuloAluno.Apresentacao.ViewModels
@{
    Layout = "_Layout";
    ViewBag.Titulo = "Alunos";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <p class="text-secondary mb-0">Gerencie os alunos da escola.</p>
    <a class="btn btn-primary" asp-action="Cadastrar">+ Novo Aluno</a>
</div>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr><th>Nome</th><th>E-mail</th><th>Telefone</th><th>CPF</th><th class="text-end">Ações</th></tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr><td colspan="5" class="text-center text-secondary py-4">Nenhum aluno cadastrado.</td></tr>
                }
                @foreach (var aluno in Model)
                {
                    <tr>
                        <td>@aluno.Nome</td>
                        <td>@aluno.Email</td>
                        <td>@aluno.Telefone</td>
                        <td>@aluno.Cpf</td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-primary" asp-controller="Matricula" asp-action="Listar" asp-route-alunoId="@aluno.Id">Matrículas</a>
                            <a class="btn btn-sm btn-outline-secondary" asp-action="Editar" asp-route-id="@aluno.Id">Editar</a>
                            <a class="btn btn-sm btn-outline-danger" asp-action="Excluir" asp-route-id="@aluno.Id">Excluir</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
