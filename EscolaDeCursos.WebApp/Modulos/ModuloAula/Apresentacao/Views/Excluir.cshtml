@model AulaExcluirViewModel
@using EscolaDeCursos.WebApp.Modulos.ModuloAula.Apresentacao.ViewModels
@{
    Layout = "_Layout";
    ViewBag.Titulo = "Excluir Módulo";
}

<div class="card shadow-sm border-danger-subtle" style="max-width: 640px;">
    <div class="card-body p-4">
        <p>Tem certeza que deseja excluir o módulo <strong>@Model.Titulo</strong>?</p>

        <form asp-action="Excluir" method="post">
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="Titulo" />
            <input type="hidden" asp-for="CursoId" />
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-danger">Confirmar exclusão</button>
                <a asp-action="Listar" asp-route-cursoId="@Model.CursoId" class="btn btn-outline-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>
