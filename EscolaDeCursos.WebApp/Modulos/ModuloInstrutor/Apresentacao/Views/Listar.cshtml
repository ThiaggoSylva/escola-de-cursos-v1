@model List<InstrutorListarViewModel>
@using EscolaDeCursos.WebApp.Modulos.ModuloInstrutor.Apresentacao.ViewModels
@{
    Layout = "_Layout";
    ViewBag.Titulo = "Instrutores";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <p class="text-secondary mb-0">Gerencie os instrutores da escola.</p>
    <a class="btn btn-primary" asp-action="Cadastrar">+ Novo Instrutor</a>
</div>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr><th>Nome</th><th>E-mail</th><th>Telefone</th><th>Especialidade</th><th class="text-end">Ações</th></tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr><td colspan="5" class="text-center text-secondary py-4">Nenhum instrutor cadastrado.</td></tr>
                }
                @foreach (var instrutor in Model)
                {
                    <tr>
                        <td>@instrutor.Nome</td>
                        <td>@instrutor.Email</td>
                        <td>@instrutor.Telefone</td>
                        <td>@instrutor.Especialidade</td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-secondary" asp-action="Editar" asp-route-id="@instrutor.Id">Editar</a>
                            <a class="btn btn-sm btn-outline-danger" asp-action="Excluir" asp-route-id="@instrutor.Id">Excluir</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
